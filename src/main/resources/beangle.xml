<?xml version="1.0"?>
<beangle>

  <ems app-name="tool-webapp"/>

  <cdi>
    <module class="org.beangle.ems.app.dao.DaoModule"/>
    <module class="org.beangle.ems.app.web.HibernateModule"/>
    <module class="org.beangle.ems.app.log.DefaultModule"/>
    <module class="org.beangle.ems.app.config.DefaultModule"/>
    <module class="org.beangle.ems.app.web.DefaultModule"/>
    <module class="org.beangle.ems.app.web.WebReconfigModule"/>
    <module class="org.beangle.ems.app.cache.DefaultModule"/>
    <module class="org.beangle.serializer.text.DefaultModule"/>
    <module class="org.beangle.serializer.json.DefaultModule"/>

    <module class="org.openurp.tool.web.ws.DefaultModule"/>
    <module class="org.openurp.tool.book.service.DefaultModule"/>
    <module class="org.openurp.tool.translate.service.DefaultModule"/>
    <module class="org.openurp.tool.enterprise.service.DefaultModule"/>
  </cdi>

  <mvc>
    <profile package="org.openurp.tool.web.ws">
      <action suffix="WS" defaultMethod="index" />
      <url path="/" suffix="" style="seo" />
      <interceptor name="web.Interceptor.hibernate"/>
    </profile>
  </mvc>

  <orm>
    <mapping class="org.openurp.tool.book.model.DefaultMapping" name="tool"/>
    <naming>
      <profile package="org.openurp.tool" pluralize="true" schema="tool"/>
    </naming>
  </orm>
</beangle>
